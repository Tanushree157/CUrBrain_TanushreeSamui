#include <vector>

using namespace std;

void runningSuffixSum(vector<int>& arr) {
    int n = static_cast<int>(arr.size());
    if (n == 0) {
        return;
    }
    int suffixSum = 0;
    for (int i = n - 1; i >= 0; --i) {
        int current = arr[i];
        arr[i] = suffixSum;
        suffixSum += current;
    }
}
