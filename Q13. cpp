
#include <iostream>
using namespace std;

bool divisiblePrefix(int arr[], int n, int k) {
    long long sum = 0;

    if (k < 0) {
        k = -k;
    }

    for (int i = 0; i < n; i++) {
        sum = sum + arr[i];

        if (sum % k == 0) {
            return true;
        }
    }

    return false;
}

int main() {
    int arr[] = {4, 2, 9};
    int n = 3;
    int k = 3;

    if (divisiblePrefix(arr, n, k)) {
        cout << "True";
    } else {
        cout << "False";
    }

    return 0;
}
