#include <iostream>
#include <cstdlib>
using namespace std;

int main() {
    int n, a, b;
    cin >> n >> a >> b;

    int countA = 0;
    int countB = 0;

    if (n == 0) {
        if (a == 0)
            countA++;

        if (b == 0)
            countB++;
    }

    while (n > 0) {
        int digit = n % 10;

        if (digit == a)
            countA++;

        if (digit == b)
            countB++;

        n = n / 10;
    }

    cout << abs(countA - countB);

    return 0;
}
