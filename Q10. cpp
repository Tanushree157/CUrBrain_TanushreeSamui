#include <iostream>
#include <vector>

int countPrimes(int n) {
    if (n <= 2) return 0;
    
    // isPrime[i] indicates whether i is prime; indices range from 0 to n - 1
    std::vector<bool> isPrime(n, true);
    isPrime[0] = false;
    isPrime[1] = false;
    
    for (long long p = 2; p * p < n; ++p) {
        if (isPrime[p]) {
            for (long long multiple = p * p; multiple < n; multiple += p) {
                isPrime[multiple] = false;
            }
        }
    }
    
    int primeCount = 0;
    for (int i = 2; i < n; ++i) {
        if (isPrime[i]) {
            ++primeCount;
        }
    }
    
    return primeCount;
}

int main() {
    std::cout << countPrimes(10) << "\n"; // Output: 4
    std::cout << countPrimes(2)  << "\n"; // Output: 0
    std::cout << countPrimes(0)  << "\n"; // Output: 0
    std::cout << countPrimes(3)  << "\n"; // Output: 1
    std::cout << countPrimes(30) << "\n"; // Output: 10
    return 0;
}
