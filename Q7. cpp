#include <iostream>
#include <vector>
#include <numeric>

int findArrayGCD(const std::vector<int>& arr) {
    if (arr.empty()) return 0;
    
    int result = arr[0];
    for (size_t i = 1; i < arr.size(); ++i) {
        result = std::gcd(result, arr[i]);
        if (result == 1) break; // Optimization: GCD cannot get smaller than 1
    }
    return result;
}

int main() {
    std::vector<int> arr1 = {24, 36, 48};
    std::cout << findArrayGCD(arr1) << "\n"; // Output: 12

    std::vector<int> arr2 = {33, 44, 55, 66};
    std::cout << findArrayGCD(arr2) << "\n"; // Output: 11

    std::vector<int> arr3 = {17};
    std::cout << findArrayGCD(arr3) << "\n"; // Output: 17

    return 0;
}
