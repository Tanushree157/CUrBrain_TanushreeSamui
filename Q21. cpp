#include <vector>

using namespace std;

void deleteByValue(vector<int>& arr, int target) {
    int n = static_cast<int>(arr.size());
    int idx = -1;
    for (int i = 0; i < n; ++i) {
        if (arr[i] == target) {
            idx = i;
            break;
        }
    }
    if (idx == -1) {
        return;
    }
    for (int i = idx; i < n - 1; ++i) {
        arr[i] = arr[i + 1];
    }
    arr.pop_back();
}
