
#include <iostream>
using namespace std;

int main() {
    long long arr[] = {1000000000, 1000000000, 1000000000};
    int n = 3;
    long long MOD = 1000000007;
    long long result = 0;

    for (int i = 0; i < n; i++) {
        result = (result + arr[i]) % MOD;
    }

    cout << result;
    return 0;
}
