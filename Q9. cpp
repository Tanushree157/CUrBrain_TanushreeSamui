#include <iostream>

bool isPrime(int x) {
    if (x <= 1) return false;
    if (x <= 3) return true;
    if (x % 2 == 0 || x % 3 == 0) return false;
    
    for (int i = 5; i * i <= x; i += 6) {
        if (x % i == 0 || x % (i + 2) == 0) {
            return false;
        }
    }
    return true;
}

int nextPrime(int n) {
    if (n < 2) return 2;
    
    int candidate = n + 1;
    while (!isPrime(candidate)) {
        ++candidate;
    }
    return candidate;
}

int main() {
    std::cout << nextPrime(14) << "\n"; // Output: 17
    std::cout << nextPrime(0)  << "\n"; // Output: 2
    std::cout << nextPrime(1)  << "\n"; // Output: 2
    std::cout << nextPrime(2)  << "\n"; // Output: 3
    std::cout << nextPrime(17) << "\n"; // Output: 19
    return 0;
}
