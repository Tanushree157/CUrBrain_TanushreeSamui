#include <vector>
#include <cmath>

int minAbsoluteValue(const std::vector<int>& arr) {
    int bestVal = arr[0];
    int minAbs = std::abs(arr[0]);
    for (size_t i = 1; i < arr.size(); ++i) {
        int currentAbs = std::abs(arr[i]);
        if (currentAbs < minAbs) {
            minAbs = currentAbs;
            bestVal = arr[i];
        }
    }
    return bestVal;
}
